# Copy to .auth-test.env and fill in. Never commit the real file: it holds a client
# secret and a cookie-signing key.
#
#   cp .auth-test.env.example .auth-test.env
#
# The three OIDC values come from your provider; see docs/auth-testing.md §2 for
# creating them in authentik, and §3 for what each one has to be.

# Per-provider issuer, WITH the trailing slash. authentik's discovery document
# returns the issuer with it, and the backend compares the two byte for byte.
OIDC_ISSUER=https://auth.titan.arrieta.eu/application/o/portfolio-prism/

OIDC_CLIENT_ID=portfolio-prism
# The provider's client secret. The backend refuses to start without it even for the
# automated checks, which is the point: a confidential client with no secret is a
# login anyone can complete against your IdP.
OIDC_CLIENT_SECRET=

# Must be registered with the provider, character for character, including the port.
# http is allowed only to localhost/127.0.0.1; anything else must be https.
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# The origin the browser actually uses. rocket_cors answers before authentication, so
# a wrong value here is a silent 403 on every write, not a 401.
ALLOWED_ORIGINS=http://localhost:8080

# Sign the session cookie. Stable across restarts, or every session dies with the
# container. Generate: openssl rand -base64 32
ROCKET_SECRET_KEY=

# Leave empty unless you mean it. Empty counts as unset; a placeholder string counts
# as SET, and setting it hands every pre-existing portfolio to that identity, with no
# undo. Read docs/auth-testing.md §6 before filling this in.
BOOTSTRAP_OWNER_SUBJ=
