        }
      }
    },
    "/api/portfolios/<portfolio_id>/transactions": {
      "get": {
        "tags": [
          "crate::api_routes::transactions"
        ],
        "operationId": "list_portfolio_transactions",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions",
            "content": {
              "application/json": {
