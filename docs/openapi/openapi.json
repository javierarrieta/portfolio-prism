  "paths": {
    "/api/assets/<id>": {
      "delete": {
        "tags": [
          "crate::api_routes::transactions"
        ],
        "operationId": "delete_asset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
