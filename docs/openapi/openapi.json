          "provider"
        ]
      },
      "ReportContext": {
        "type": "object",
        "description": "What a dated request was answered about. `ReportContext` is the single authority for\n`strategy` and `threshold_days`: the response does not repeat them at top level.",
        "required": [
          "portfolio_id",
          "portfolio_name",
