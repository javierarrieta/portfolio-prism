    "/api/transactions/<id>": {
      "delete": {
        "tags": [
          "crate::api_routes::transactions"
        ],
        "operationId": "delete_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Transaction deleted"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    },
    "/api/transactions/<id>/pnl": {
      "get": {
        "tags": [
          "crate::api_routes::analytics"
        ],
        "operationId": "get_transaction_sell_pnl",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Sell transaction id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "strategy",
            "in": "query",
            "description": "FIFO, LIFO or HYBRID (default FIFO)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "threshold_days",
            "in": "query",
            "description": "HYBRID short-term threshold (default 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Realized P&L breakdown for the sell",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellPnlResponse"
                }
              }
            }
          },
          "400": {
            "description": "Transaction is not a SELL"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Asset": {
        "type": "object",
        "required": [
          "id",
          "portfolio_id",
          "symbol",
          "name",
          "asset_type",
          "currency"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "isin": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "portfolio_id": {
            "type": "integer",
            "format": "int32"
          },
          "sector": {
            "type": "string",
            "nullable": true
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "AssetCreate": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "asset_type",
          "currency"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "isin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sector": {
            "type": "string",
            "nullable": true
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "AssetLookupResult": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "asset_type"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "AssetOut": {
        "type": "object",
        "required": [
          "id",
          "portfolio_id",
          "symbol",
          "name",
          "asset_type",
          "currency",
          "transactions"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "isin": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "portfolio_id": {
            "type": "integer",
            "format": "int32"
          },
          "sector": {
            "type": "string",
            "nullable": true
          },
          "symbol": {
            "type": "string"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionOut"
            }
          }
        }
      },
      "AssetTaxSummary": {
        "type": "object",
        "required": [
          "symbol",
          "asset_type",
          "current_shares",
          "average_cost",
          "current_price",
          "total_cost",
          "market_value",
          "unrealized_pnl",
          "unrealized_roi",
          "realized_pnl",
          "tax_lots"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "average_cost": {
            "type": "string"
          },
          "current_price": {
            "type": "string"
          },
          "current_shares": {
            "type": "string"
          },
          "market_value": {
            "type": "string"
          },
          "realized_pnl": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "tax_lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxLot"
            }
          },
          "total_cost": {
            "type": "string"
          },
          "unrealized_pnl": {
            "type": "string"
          },
          "unrealized_roi": {
            "type": "string"
          }
        }
      },
      "AssetTotals": {
        "type": "object",
        "description": "One asset's dated totals. Every field is computed in Rust from the same replay that\nproduced the rows; no renderer sums anything.",
        "required": [
          "asset_id",
          "symbol",
          "asset_type",
          "asset_currency",
          "realized_in_window",
          "realized_cumulative",
          "unrealized_at_end",
          "market_value",
          "cost_basis",
          "fx_applied",
          "split_applied"
        ],
        "properties": {
          "asset_currency": {
            "type": "string"
          },
          "asset_id": {
            "type": "integer",
            "format": "int32"
          },
          "asset_type": {
            "type": "string"
          },
          "cost_basis": {
            "type": "string"
          },
          "fx_applied": {
            "type": "boolean"
          },
          "fx_rate_date_used": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "market_value": {
            "type": "string"
          },
          "price_date_used": {
            "type": "string",
            "format": "date",
            "description": "The close that priced this asset, and the date it actually came from. Null when\nthe asset has no transaction at or before the window end, so no close was needed.",
            "nullable": true
          },
          "price_source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PriceSource"
              }
            ],
            "nullable": true
          },
          "realized_cumulative": {
            "type": "string"
          },
          "realized_in_window": {
            "type": "string"
          },
          "split_applied": {
            "type": "boolean",
            "description": "A SPLIT dated on or before the window end was applied to the lots in scope."
          },
          "symbol": {
            "type": "string"
          },
          "unrealized_at_end": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The one body every failure returns. Validation failures carry an empty pair of lists\nand name the offending parameter in `error`; a pricing failure populates them.",
        "required": [
          "error",
          "missing_prices",
          "missing_rates",
          "missing_prices_total",
          "missing_rates_total",
          "retryable"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "missing_prices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_prices_total": {
            "type": "integer",
            "description": "How many were found, before the lists were capped. Truncation is never silent.",
            "minimum": 0
          },
          "missing_rates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissingRate"
            }
          },
          "missing_rates_total": {
            "type": "integer",
            "minimum": 0
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "LotMatch": {
        "type": "object",
        "description": "One row per buy lot consumed by one sell. `buy_price` and `unit_cost` are\nsplit-adjusted and expressed in the portfolio base currency; `unit_cost`\nadditionally carries the amortised buy fee.",
        "required": [
          "buy_transaction_id",
          "buy_date",
          "buy_price",
          "unit_cost",
          "matched_qty",
          "lot_qty_before_match",
          "cost_basis",
          "proceeds",
          "pnl",
          "holding_days"
        ],
        "properties": {
          "buy_date": {
            "type": "string",
            "format": "date-time"
          },
          "buy_price": {
            "type": "string"
          },
          "buy_transaction_id": {
            "type": "integer",
            "format": "int32"
          },
          "cost_basis": {
            "type": "string"
          },
          "holding_days": {
            "type": "integer",
            "format": "int64"
          },
          "lot_qty_before_match": {
            "type": "string"
          },
          "matched_qty": {
            "type": "string"
          },
          "pnl": {
            "type": "string"
          },
          "proceeds": {
            "type": "string"
          },
          "term": {
            "type": "string",
            "description": "\"SHORT\" | \"LONG\", populated for the HYBRID strategy only; null otherwise.",
            "nullable": true
          },
          "unit_cost": {
            "type": "string"
          }
        }
      },
      "MissingRate": {
        "type": "object",
        "description": "One currency pair a rate could not be found for. A missing rate is a pair, not a\nsymbol, and the body says which it is.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "Portfolio": {
        "type": "object",
        "required": [
          "id",
          "name",
          "currency",
          "base_currency"
        ],
        "properties": {
          "base_currency": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PortfolioCreate": {
        "type": "object",
        "required": [
          "name",
          "currency"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PortfolioOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "currency",
          "assets"
        ],
