    "/api/assets/lookup": {
      "get": {
        "tags": [
          "crate::api_routes::lookup"
        ],
        "operationId": "lookup_isin",
        "parameters": [
          {
            "name": "isin",
            "in": "query",
            "description": "ISIN to look up (12 alphanumeric characters)",
