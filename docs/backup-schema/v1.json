{
  "$defs": {
    "BundleAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ref": {
          "description": "Bundle-local label (`a1`, `a2`), unique in the same namespace as the portfolio\nrefs. Never a database id and never read during restore — the portfolio that\nnests the asset is its parent, so no label has to carry that link.",
          "type": "string"
        },
        "sector": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": "string"
        },
        "transactions": {
          "items": {
            "$ref": "#/$defs/BundleTransaction"
          },
          "type": "array"
        }
      },
      "required": [
        "ref",
        "symbol",
        "name",
        "asset_type",
        "currency",
        "transactions"
      ],
      "type": "object"
    },
    "BundlePortfolio": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/BundleAsset"
          },
          "type": "array"
        },
        "base_currency": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ref": {
          "description": "Bundle-local label (`p1`, `p2`), unique bundle-wide: portfolio refs and asset\nrefs share one namespace, so an asset ref may not equal a portfolio ref\neither. Never a database id, never persisted, and never read during restore —\nthe nesting carries the parent/child link. `ref` is a Rust keyword, hence the\nrename.",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "name",
        "currency",
        "base_currency",
        "assets"
      ],
      "type": "object"
    },
    "BundlePrice": {
      "additionalProperties": false,
      "properties": {
        "close_price": {
          "type": "string"
        },
        "date": {
          "description": "`YYYY-MM-DD`, matching `models::HistoricalPrice::date`.",
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "date",
        "close_price"
      ],
      "type": "object"
    },
    "BundleTransaction": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "RFC 3339 UTC datetime, matching `models::Transaction::date`.",
          "type": "string"
        },
        "fee": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "quantity": {
          "description": "Decimal as a string, matching the TEXT column and `models::Transaction`.",
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "quantity",
        "price",
        "fee",
        "date"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "description": "RFC 3339 UTC, informational. Excluded from the round-trip equality test.",
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "portfolios": {
      "items": {
        "$ref": "#/$defs/BundlePortfolio"
      },
      "type": "array"
    },
    "prices": {
      "description": "Absent unless requested at export time. Flat, because price rows are\nglobal and belong to no portfolio.",
      "items": {
        "$ref": "#/$defs/BundlePrice"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "format",
    "schema_version",
    "created_at",
    "portfolios"
  ],
  "title": "Bundle",
  "type": "object"
}
